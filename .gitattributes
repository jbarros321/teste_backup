
# Arquivos de texto devem usar LF (Unix) line endings
*.java text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.mxml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Arquivos binários
*.jar binary
*.war binary
*.ear binary
*.zip binary
*.rar binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.avi binary
*.mov binary

# Arquivos de configuração específicos
.gitignore text eol=lf
.gitattributes text eol=lf
.cursorignore text eol=lf
.cursorrules text eol=lf
