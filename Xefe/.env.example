# =====================================================================
# Xefe — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione o arquivo preenchido.
# =====================================================================

# ---------------------------------------------------------------------
# FRONT-END (Vite) — só pode conter valores públicos.
# A anon key é pública por design: quem protege os dados é o RLS.
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_APP_NAME=Xefe
VITE_SENTRY_DSN=

# ---------------------------------------------------------------------
# EDGE FUNCTIONS — configurado por `supabase secrets set`, não por arquivo.
# Listado aqui apenas como documentação do que precisa existir.
# ---------------------------------------------------------------------
# supabase secrets set GEMINI_API_KEY=AIza...
# supabase secrets set APP_ORIGIN=https://app.seudominio.com
#
# Injetadas automaticamente pelo Supabase nas functions:
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------
# NUNCA coloque no front-end:
#   SUPABASE_SERVICE_ROLE_KEY   -> ignora todo o RLS
#   GEMINI_API_KEY              -> chave paga, exposta no bundle
# ---------------------------------------------------------------------
