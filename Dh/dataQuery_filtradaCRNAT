/* =========================================================    RECEITAS (Vendas) - TIPMOV = 'V' ========================================================= */ SELECT     CONCAT('N_', C.CODNAT) AS ID,      SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='01' THEN ABS(ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST) ELSE 0 END) AS JAN,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='02' THEN ABS(ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST) ELSE 0 END) AS FEV,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='03' THEN ABS(ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST) ELSE 0 END) AS MAR,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='04' THEN ABS(ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST) ELSE 0 END) AS ABR,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='05' THEN ABS(ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST) ELSE 0 END) AS MAI,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='06' THEN ABS(ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST) ELSE 0 END) AS JUN,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='07' THEN ABS(ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST) ELSE 0 END) AS JUL,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='08' THEN ABS(ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST) ELSE 0 END) AS AGO,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='09' THEN ABS(ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST) ELSE 0 END) AS SETEMBRO,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='10' THEN ABS(ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST) ELSE 0 END) AS OUTUBRO,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='11' THEN ABS(ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST) ELSE 0 END) AS NOV,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='12' THEN ABS(ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST) ELSE 0 END) AS DEZ,      SUM(ABS(ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST)) AS TOTAL_ANO  FROM IMP_IMP_CAB C JOIN IMP_NATUREZA N     ON N.CODNAT = C.CODNAT JOIN IMP_IMP_TOP T     ON C.CODTIPOPER = T.CODTIPOPER    AND C.DHTIPOPER = T.DHALTER JOIN IMP_IMP_ITE ITE     ON C.NUNOTA = ITE.NUNOTA  WHERE     (:VAR_DATA_INICIO IS NULL OR :VAR_DATA_INICIO = '' OR C.DTNEG >= TO_DATE(SUBSTR(:VAR_DATA_INICIO, 1, 10), 'YYYY-MM-DD')) AND (:VAR_DATA_FIM IS NULL OR :VAR_DATA_FIM = '' OR C.DTNEG < (TO_DATE(SUBSTR(:VAR_DATA_FIM, 1, 10), 'YYYY-MM-DD') + 1)) AND T.GOLSINAL = -1 AND C.TIPMOV = 'V' AND C.STATUSNOTA = 'L' AND (:VAR_NATUREZA IS NULL OR :VAR_NATUREZA = '' OR INSTR(',' || :VAR_NATUREZA || ',', ',' || C.CODNAT || ',') > 0) AND (:VAR_CENTRO_RESULTADO IS NULL OR :VAR_CENTRO_RESULTADO = '' OR INSTR(',' || :VAR_CENTRO_RESULTADO || ',', ',' || C.CODCENCUS || ',') > 0) GROUP BY N.CODNAT UNION ALL /* =========================================================    DEVOLUÇÕES ========================================================= */ SELECT     CONCAT('N_', C.CODNAT) AS ID,      SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='01' THEN ABS((ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST)*-1) ELSE 0 END) AS JAN,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='02' THEN ABS((ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST)*-1) ELSE 0 END) AS FEV,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='03' THEN ABS((ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST)*-1) ELSE 0 END) AS MAR,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='04' THEN ABS((ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST)*-1) ELSE 0 END) AS ABR,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='05' THEN ABS((ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST)*-1) ELSE 0 END) AS MAI,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='06' THEN ABS((ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST)*-1) ELSE 0 END) AS JUN,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='07' THEN ABS((ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST)*-1) ELSE 0 END) AS JUL,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='08' THEN ABS((ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST)*-1) ELSE 0 END) AS AGO,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='09' THEN ABS((ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST)*-1) ELSE 0 END) AS SETEMBRO,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='10' THEN ABS((ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST)*-1) ELSE 0 END) AS OUTUBRO,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='11' THEN ABS((ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST)*-1) ELSE 0 END) AS NOV,     SUM(CASE WHEN TO_CHAR(C.DTNEG,'MM')='12' THEN ABS((ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST)*-1) ELSE 0 END) AS DEZ,      SUM(ABS((ITE.VLRTOT - ITE.VLRDESC + ITE.VLRIPI + ITE.VLRSUBST)*-1)) AS TOTAL_ANO  FROM IMP_IMP_CAB C JOIN IMP_NATUREZA N     ON C.CODNAT = N.CODNAT JOIN IMP_IMP_TOP T     ON C.CODTIPOPER = T.CODTIPOPER    AND C.DHTIPOPER = T.DHALTER JOIN IMP_IMP_ITE ITE     ON C.NUNOTA = ITE.NUNOTA  WHERE     (:VAR_DATA_INICIO IS NULL OR :VAR_DATA_INICIO = '' OR C.DTNEG >= TO_DATE(SUBSTR(:VAR_DATA_INICIO, 1, 10), 'YYYY-MM-DD')) AND (:VAR_DATA_FIM IS NULL OR :VAR_DATA_FIM = '' OR C.DTNEG < (TO_DATE(SUBSTR(:VAR_DATA_FIM, 1, 10), 'YYYY-MM-DD') + 1)) AND T.GOLDEV = -1 AND C.TIPMOV = 'D'   AND C.STATUSNOTA = 'L' AND C.CODNAT NOT IN (1101001,1103005,1103006) AND (:VAR_NATUREZA IS NULL OR :VAR_NATUREZA = '' OR INSTR(',' || :VAR_NATUREZA || ',', ',' || C.CODNAT || ',') > 0) AND (:VAR_CENTRO_RESULTADO IS NULL OR :VAR_CENTRO_RESULTADO = '' OR INSTR(',' || :VAR_CENTRO_RESULTADO || ',', ',' || C.CODCENCUS || ',') > 0) GROUP BY N.CODNAT UNION ALL /* =========================================================    FINANCEIRO ========================================================= */ SELECT     CONCAT('N_', F.CODNAT) AS ID,      SUM(CASE WHEN TO_CHAR(F.DTNEG,'MM')='01' THEN ABS(F.VALOR * F.RECDESP) ELSE 0 END) AS JAN,     SUM(CASE WHEN TO_CHAR(F.DTNEG,'MM')='02' THEN ABS(F.VALOR * F.RECDESP) ELSE 0 END) AS FEV,     SUM(CASE WHEN TO_CHAR(F.DTNEG,'MM')='03' THEN ABS(F.VALOR * F.RECDESP) ELSE 0 END) AS MAR,     SUM(CASE WHEN TO_CHAR(F.DTNEG,'MM')='04' THEN ABS(F.VALOR * F.RECDESP) ELSE 0 END) AS ABR,     SUM(CASE WHEN TO_CHAR(F.DTNEG,'MM')='05' THEN ABS(F.VALOR * F.RECDESP) ELSE 0 END) AS MAI,     SUM(CASE WHEN TO_CHAR(F.DTNEG,'MM')='06' THEN ABS(F.VALOR * F.RECDESP) ELSE 0 END) AS JUN,     SUM(CASE WHEN TO_CHAR(F.DTNEG,'MM')='07' THEN ABS(F.VALOR * F.RECDESP) ELSE 0 END) AS JUL,     SUM(CASE WHEN TO_CHAR(F.DTNEG,'MM')='08' THEN ABS(F.VALOR * F.RECDESP) ELSE 0 END) AS AGO,     SUM(CASE WHEN TO_CHAR(F.DTNEG,'MM')='09' THEN ABS(F.VALOR * F.RECDESP) ELSE 0 END) AS SETEMBRO,     SUM(CASE WHEN TO_CHAR(F.DTNEG,'MM')='10' THEN ABS(F.VALOR * F.RECDESP) ELSE 0 END) AS OUTUBRO,     SUM(CASE WHEN TO_CHAR(F.DTNEG,'MM')='11' THEN ABS(F.VALOR * F.RECDESP) ELSE 0 END) AS NOV,     SUM(CASE WHEN TO_CHAR(F.DTNEG,'MM')='12' THEN ABS(F.VALOR * F.RECDESP) ELSE 0 END) AS DEZ,      SUM(ABS(F.VALOR * F.RECDESP)) AS TOTAL_ANO  FROM IMP_FINANCEIRO_DRE F  WHERE     (:VAR_DATA_INICIO IS NULL OR :VAR_DATA_INICIO = '' OR F.DTNEG >= TO_DATE(SUBSTR(:VAR_DATA_INICIO, 1, 10), 'YYYY-MM-DD')) AND (:VAR_DATA_FIM IS NULL OR :VAR_DATA_FIM = '' OR F.DTNEG < (TO_DATE(SUBSTR(:VAR_DATA_FIM, 1, 10), 'YYYY-MM-DD') + 1)) AND (F.RECDESP = -1 OR (F.RECDESP = 1 AND F.NUNOTA IS NULL)) AND F.CODNAT NOT IN (1101001,1103005,1103006,1102001,1102002) AND (:VAR_NATUREZA IS NULL OR :VAR_NATUREZA = '' OR INSTR(',' || :VAR_NATUREZA || ',', ',' || F.CODNAT || ',') > 0) AND (:VAR_CENTRO_RESULTADO IS NULL OR :VAR_CENTRO_RESULTADO = '' OR INSTR(',' || :VAR_CENTRO_RESULTADO || ',', ',' || F.CODCENCUS || ',') > 0) GROUP BY F.CODNAT UNION ALL /* =========================================================    CMV ========================================================= */ SELECT     CONCAT('N_',99998) AS ID,      SUM(CASE WHEN TO_CHAR(MES_REF,'MM')='01' THEN ABS(CMV) ELSE 0 END) AS JAN,     SUM(CASE WHEN TO_CHAR(MES_REF,'MM')='02' THEN ABS(CMV) ELSE 0 END) AS FEV,     SUM(CASE WHEN TO_CHAR(MES_REF,'MM')='03' THEN ABS(CMV) ELSE 0 END) AS MAR,     SUM(CASE WHEN TO_CHAR(MES_REF,'MM')='04' THEN ABS(CMV) ELSE 0 END) AS ABR,     SUM(CASE WHEN TO_CHAR(MES_REF,'MM')='05' THEN ABS(CMV) ELSE 0 END) AS MAI,     SUM(CASE WHEN TO_CHAR(MES_REF,'MM')='06' THEN ABS(CMV) ELSE 0 END) AS JUN,     SUM(CASE WHEN TO_CHAR(MES_REF,'MM')='07' THEN ABS(CMV) ELSE 0 END) AS JUL,     SUM(CASE WHEN TO_CHAR(MES_REF,'MM')='08' THEN ABS(CMV) ELSE 0 END) AS AGO,     SUM(CASE WHEN TO_CHAR(MES_REF,'MM')='09' THEN ABS(CMV) ELSE 0 END) AS SETEMBRO,     SUM(CASE WHEN TO_CHAR(MES_REF,'MM')='10' THEN ABS(CMV) ELSE 0 END) AS OUTUBRO,     SUM(CASE WHEN TO_CHAR(MES_REF,'MM')='11' THEN ABS(CMV) ELSE 0 END) AS NOV,     SUM(CASE WHEN TO_CHAR(MES_REF,'MM')='12' THEN ABS(CMV) ELSE 0 END) AS DEZ,      SUM(ABS(CMV)) AS TOTAL_ANO  FROM IMP_CMV  WHERE     (:VAR_DATA_INICIO IS NULL OR :VAR_DATA_INICIO = '' OR MES_REF >= TO_DATE(SUBSTR(:VAR_DATA_INICIO, 1, 10), 'YYYY-MM-DD')) AND (:VAR_DATA_FIM IS NULL OR :VAR_DATA_FIM = '' OR MES_REF < (TO_DATE(SUBSTR(:VAR_DATA_FIM, 1, 10), 'YYYY-MM-DD') + 1))   UNION ALL   /* =========================================================    DEPRECIAÇÃO ========================================================= */ SELECT     CONCAT('N_',99996) AS ID,      SUM(CASE WHEN SUBSTR(PERIODO,4,2)='01' THEN VALOR ELSE 0 END) AS JAN,     SUM(CASE WHEN SUBSTR(PERIODO,4,2)='02' THEN VALOR ELSE 0 END) AS FEV,     SUM(CASE WHEN SUBSTR(PERIODO,4,2)='03' THEN VALOR ELSE 0 END) AS MAR,     SUM(CASE WHEN SUBSTR(PERIODO,4,2)='04' THEN VALOR ELSE 0 END) AS ABR,     SUM(CASE WHEN SUBSTR(PERIODO,4,2)='05' THEN VALOR ELSE 0 END) AS MAI,     SUM(CASE WHEN SUBSTR(PERIODO,4,2)='06' THEN VALOR ELSE 0 END) AS JUN,     SUM(CASE WHEN SUBSTR(PERIODO,4,2)='07' THEN VALOR ELSE 0 END) AS JUL,     SUM(CASE WHEN SUBSTR(PERIODO,4,2)='08' THEN VALOR ELSE 0 END) AS AGO,     SUM(CASE WHEN SUBSTR(PERIODO,4,2)='09' THEN VALOR ELSE 0 END) AS SETEMBRO,     SUM(CASE WHEN SUBSTR(PERIODO,4,2)='10' THEN VALOR ELSE 0 END) AS OUTUBRO,     SUM(CASE WHEN SUBSTR(PERIODO,4,2)='11' THEN VALOR ELSE 0 END) AS NOV,     SUM(CASE WHEN SUBSTR(PERIODO,4,2)='12' THEN VALOR ELSE 0 END) AS DEZ,      SUM(VALOR) AS TOTAL_ANO  FROM DEPRECIACAO  WHERE     (:VAR_DATA_INICIO IS NULL OR :VAR_DATA_INICIO = '' OR TO_DATE(PERIODO,'DD/MM/YYYY') >= TO_DATE(SUBSTR(:VAR_DATA_INICIO, 1, 10), 'YYYY-MM-DD')) AND (:VAR_DATA_FIM IS NULL OR :VAR_DATA_FIM = '' OR TO_DATE(PERIODO,'DD/MM/YYYY') < (TO_DATE(SUBSTR(:VAR_DATA_FIM, 1, 10), 'YYYY-MM-DD') + 1)) UNION ALL /* =========================================================    VARIAÇÃO CAMBIAL    ========================================================= */ SELECT     CASE         WHEN VC.TIPVAR = 'P' THEN CONCAT('N_', 99994)         WHEN VC.TIPVAR = 'N' THEN CONCAT('N_', 99995)     END AS ID,     SUM(CASE WHEN TO_CHAR(VC.DTREF,'MM')='01' THEN VC.VALOR ELSE 0 END) AS JAN,     SUM(CASE WHEN TO_CHAR(VC.DTREF,'MM')='02' THEN VC.VALOR ELSE 0 END) AS FEV,     SUM(CASE WHEN TO_CHAR(VC.DTREF,'MM')='03' THEN VC.VALOR ELSE 0 END) AS MAR,     SUM(CASE WHEN TO_CHAR(VC.DTREF,'MM')='04' THEN VC.VALOR ELSE 0 END) AS ABR,     SUM(CASE WHEN TO_CHAR(VC.DTREF,'MM')='05' THEN VC.VALOR ELSE 0 END) AS MAI,     SUM(CASE WHEN TO_CHAR(VC.DTREF,'MM')='06' THEN VC.VALOR ELSE 0 END) AS JUN,     SUM(CASE WHEN TO_CHAR(VC.DTREF,'MM')='07' THEN VC.VALOR ELSE 0 END) AS JUL,     SUM(CASE WHEN TO_CHAR(VC.DTREF,'MM')='08' THEN VC.VALOR ELSE 0 END) AS AGO,     SUM(CASE WHEN TO_CHAR(VC.DTREF,'MM')='09' THEN VC.VALOR ELSE 0 END) AS SETEMBRO,     SUM(CASE WHEN TO_CHAR(VC.DTREF,'MM')='10' THEN VC.VALOR ELSE 0 END) AS OUTUBRO,     SUM(CASE WHEN TO_CHAR(VC.DTREF,'MM')='11' THEN VC.VALOR ELSE 0 END) AS NOV,     SUM(CASE WHEN TO_CHAR(VC.DTREF,'MM')='12' THEN VC.VALOR ELSE 0 END) AS DEZ,     SUM(VC.VALOR) AS TOTAL_ANO FROM IMP_VARIACAO_CAMB VC WHERE     (:VAR_DATA_INICIO IS NULL OR :VAR_DATA_INICIO = '' OR VC.DTREF >= TO_DATE(SUBSTR(:VAR_DATA_INICIO, 1, 10), 'YYYY-MM-DD')) AND (:VAR_DATA_FIM IS NULL OR :VAR_DATA_FIM = '' OR VC.DTREF < (TO_DATE(SUBSTR(:VAR_DATA_FIM, 1, 10), 'YYYY-MM-DD') + 1)) AND (:VAR_NATUREZA IS NULL OR :VAR_NATUREZA = '' OR INSTR(',' || :VAR_NATUREZA || ',', ',' || VC.CODNAT || ',') > 0) AND (:VAR_CENTRO_RESULTADO IS NULL OR :VAR_CENTRO_RESULTADO = '' OR INSTR(',' || :VAR_CENTRO_RESULTADO || ',', ',' || VC.CODCENCUS || ',') > 0) GROUP BY ID UNION ALL /* =========================================================    DESCONTOS OBTIDOS E CONCEDIDOS    ========================================================= */ SELECT     CASE         WHEN D.RECDESP = -1 THEN CONCAT('N_', 99993)         WHEN D.RECDESP = 1 THEN CONCAT('N_', 99992)     END AS ID,     SUM(CASE WHEN TO_CHAR(D.DTREF,'MM')='01' THEN D.VALOR ELSE 0 END) AS JAN,     SUM(CASE WHEN TO_CHAR(D.DTREF,'MM')='02' THEN D.VALOR ELSE 0 END) AS FEV,     SUM(CASE WHEN TO_CHAR(D.DTREF,'MM')='03' THEN D.VALOR ELSE 0 END) AS MAR,     SUM(CASE WHEN TO_CHAR(D.DTREF,'MM')='04' THEN D.VALOR ELSE 0 END) AS ABR,     SUM(CASE WHEN TO_CHAR(D.DTREF,'MM')='05' THEN D.VALOR ELSE 0 END) AS MAI,     SUM(CASE WHEN TO_CHAR(D.DTREF,'MM')='06' THEN D.VALOR ELSE 0 END) AS JUN,     SUM(CASE WHEN TO_CHAR(D.DTREF,'MM')='07' THEN D.VALOR ELSE 0 END) AS JUL,     SUM(CASE WHEN TO_CHAR(D.DTREF,'MM')='08' THEN D.VALOR ELSE 0 END) AS AGO,     SUM(CASE WHEN TO_CHAR(D.DTREF,'MM')='09' THEN D.VALOR ELSE 0 END) AS SETEMBRO,     SUM(CASE WHEN TO_CHAR(D.DTREF,'MM')='10' THEN D.VALOR ELSE 0 END) AS OUTUBRO,     SUM(CASE WHEN TO_CHAR(D.DTREF,'MM')='11' THEN D.VALOR ELSE 0 END) AS NOV,     SUM(CASE WHEN TO_CHAR(D.DTREF,'MM')='12' THEN D.VALOR ELSE 0 END) AS DEZ,     SUM(D.VALOR) AS TOTAL_ANO FROM IMP_DESCONTOS_CONC D WHERE     (:VAR_DATA_INICIO IS NULL OR :VAR_DATA_INICIO = '' OR D.DTREF >= TO_DATE(SUBSTR(:VAR_DATA_INICIO, 1, 10), 'YYYY-MM-DD'))     AND (:VAR_DATA_FIM IS NULL OR :VAR_DATA_FIM = '' OR D.DTREF < (TO_DATE(SUBSTR(:VAR_DATA_FIM, 1, 10), 'YYYY-MM-DD') + 1)) AND (:VAR_NATUREZA IS NULL OR :VAR_NATUREZA = '' OR INSTR(',' || :VAR_NATUREZA || ',', ',' || D.CODNAT || ',') > 0) AND (:VAR_CENTRO_RESULTADO IS NULL OR :VAR_CENTRO_RESULTADO = '' OR INSTR(',' || :VAR_CENTRO_RESULTADO || ',', ',' || D.CODCENCUS || ',') > 0) GROUP BY ID UNION ALL /* =========================================================    JUROS E MULTAS    ========================================================= */ SELECT     ID,     SUM(JAN) AS JAN, SUM(FEV) AS FEV, SUM(MAR) AS MAR, SUM(ABR) AS ABR,     SUM(MAI) AS MAI, SUM(JUN) AS JUN, SUM(JUL) AS JUL, SUM(AGO) AS AGO,     SUM(SETEMBRO) AS SETEMBRO, SUM(OUTUBRO) AS OUTUBRO, SUM(NOV) AS NOV, SUM(DEZ) AS DEZ,     SUM(TOTAL_ANO) AS TOTAL_ANO FROM (     SELECT         CASE             WHEN JM.RECDESP = 1 THEN CONCAT('N_', 99991)             WHEN JM.RECDESP = -1 THEN CONCAT('N_', 99989)         END AS ID,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='01' THEN JM.JUROS ELSE 0 END) AS JAN,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='02' THEN JM.JUROS ELSE 0 END) AS FEV,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='03' THEN JM.JUROS ELSE 0 END) AS MAR,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='04' THEN JM.JUROS ELSE 0 END) AS ABR,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='05' THEN JM.JUROS ELSE 0 END) AS MAI,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='06' THEN JM.JUROS ELSE 0 END) AS JUN,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='07' THEN JM.JUROS ELSE 0 END) AS JUL,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='08' THEN JM.JUROS ELSE 0 END) AS AGO,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='09' THEN JM.JUROS ELSE 0 END) AS SETEMBRO,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='10' THEN JM.JUROS ELSE 0 END) AS OUTUBRO,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='11' THEN JM.JUROS ELSE 0 END) AS NOV,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='12' THEN JM.JUROS ELSE 0 END) AS DEZ,         SUM(JM.JUROS) AS TOTAL_ANO     FROM IMP_JUROS_MULTAS JM     WHERE JM.JUROS > 0       AND (:VAR_DATA_INICIO IS NULL OR :VAR_DATA_INICIO = '' OR JM.DTREF >= TO_DATE(SUBSTR(:VAR_DATA_INICIO, 1, 10), 'YYYY-MM-DD'))       AND (:VAR_DATA_FIM IS NULL OR :VAR_DATA_FIM = '' OR JM.DTREF < (TO_DATE(SUBSTR(:VAR_DATA_FIM, 1, 10), 'YYYY-MM-DD') + 1)) AND (:VAR_NATUREZA IS NULL OR :VAR_NATUREZA = '' OR INSTR(',' || :VAR_NATUREZA || ',', ',' || JM.CODNAT || ',') > 0) AND (:VAR_CENTRO_RESULTADO IS NULL OR :VAR_CENTRO_RESULTADO = '' OR INSTR(',' || :VAR_CENTRO_RESULTADO || ',', ',' || JM.CODCENCUS || ',') > 0)     GROUP BY ID     UNION ALL     SELECT         CASE             WHEN JM.RECDESP = 1 THEN CONCAT('N_', 99990)             WHEN JM.RECDESP = -1 THEN CONCAT('N_', 99988)         END AS ID,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='01' THEN JM.MULTA ELSE 0 END) AS JAN,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='02' THEN JM.MULTA ELSE 0 END) AS FEV,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='03' THEN JM.MULTA ELSE 0 END) AS MAR,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='04' THEN JM.MULTA ELSE 0 END) AS ABR,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='05' THEN JM.MULTA ELSE 0 END) AS MAI,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='06' THEN JM.MULTA ELSE 0 END) AS JUN,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='07' THEN JM.MULTA ELSE 0 END) AS JUL,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='08' THEN JM.MULTA ELSE 0 END) AS AGO,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='09' THEN JM.MULTA ELSE 0 END) AS SETEMBRO,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='10' THEN JM.MULTA ELSE 0 END) AS OUTUBRO,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='11' THEN JM.MULTA ELSE 0 END) AS NOV,         SUM(CASE WHEN TO_CHAR(JM.DTREF,'MM')='12' THEN JM.MULTA ELSE 0 END) AS DEZ,         SUM(JM.MULTA) AS TOTAL_ANO     FROM IMP_JUROS_MULTAS JM     WHERE JM.MULTA > 0       AND (:VAR_DATA_INICIO IS NULL OR :VAR_DATA_INICIO = '' OR JM.DTREF >= TO_DATE(SUBSTR(:VAR_DATA_INICIO, 1, 10), 'YYYY-MM-DD'))       AND (:VAR_DATA_FIM IS NULL OR :VAR_DATA_FIM = '' OR JM.DTREF < (TO_DATE(SUBSTR(:VAR_DATA_FIM, 1, 10), 'YYYY-MM-DD') + 1)) AND (:VAR_NATUREZA IS NULL OR :VAR_NATUREZA = '' OR INSTR(',' || :VAR_NATUREZA || ',', ',' || JM.CODNAT || ',') > 0) AND (:VAR_CENTRO_RESULTADO IS NULL OR :VAR_CENTRO_RESULTADO = '' OR INSTR(',' || :VAR_CENTRO_RESULTADO || ',', ',' || JM.CODCENCUS || ',') > 0)     GROUP BY ID ) AS JurosMultas GROUP BY ID