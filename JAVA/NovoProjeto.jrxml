	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["d:\\Developer\\Relatoriso - iReport\\modelos\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="NUPROJ" class="java.lang.String">
		<property name="NOMETABELA" value="AD_CTRPROJMOB"/>
		<parameterDescription><![CDATA[Projeto]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT
NUPROJ
,DESCRPROJ
,VLRORC
,PROJVINCU
,(SELECT NOMEUSU FROM TSIUSU WHERE CODUSU = GESTORPROJ) AS GESTORPROJ
,CASE WHEN NVL(INCLORCANUAL,'N')= 'N' THEN 'Sim' else 'Não' END AS INCLORCANUAL
,AREA

,CASE
WHEN TIPOPROJ = 'A'	 THEN 'Aumento Receita/Margem'
WHEN TIPOPROJ = 'R'	 THEN 'Redução de Custo'
WHEN TIPOPROJ = 'S'	 THEN 'Substituição'
WHEN TIPOPROJ = 'M'	 THEN 'Manutenção'
WHEN TIPOPROJ = 'SS'  THEN 'Saúde/Segurança'
WHEN TIPOPROJ = 'O'	 THEN 'Outros'

END AS

TIPOPROJ
,OBSOUTROS
,DTPREV
,JUSTIFICATIVA
,ESCOPO
,BENEFICIOS
,RISCOS
,CASE
WHEN STATUSPROJ ='A'  THEN 'Aprovado'
WHEN STATUSPROJ ='S'  THEN 'Submetido'
WHEN STATUSPROJ ='R'  THEN 'Reprovado'
WHEN STATUSPROJ ='P'  THEN 'Aguardando Submeter'
WHEN STATUSPROJ ='AR' THEN 'Aguardando Reajuste'

END AS STATUSPROJ



,NOTIFICADO
,SYSDATE
,(SELECT NOMEUSU FROM TSIUSU WHERE CODUSU = CODUSUINC) AS USUCRIADOR
,DTPREV


FROM

AD_CTRPROJMOB

WHERE NUPROJ = $P{NUPROJ}]]>
	</queryString>
