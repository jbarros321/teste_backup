	<property name="ireport.zoom" value="2.1961500000000007"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.definition"/>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DTAINICIAL" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Dta.Inicial]]></parameterDescription>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="DTFINAL" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Dta.Final]]></parameterDescription>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="CODMOTORISTA" class="java.lang.String">
		<property name="NOMETABELA" value="TGFPAR"/>
		<property name="PESQUISA" value="TRUE"/>
		<parameterDescription><![CDATA[Motorista]]></parameterDescription>
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="P_PROJETO" class="java.math.BigDecimal" isForPrompting="false"/>
	<queryString>
		<![CDATA[WITH FretePorOrdem AS
  (SELECT ORDEMCARGA,
          CODPARCMOTORISTA,
          SUM(VLRFRETE) AS VLRFRETE
   FROM TGFORD
   WHERE CODPARCMOTORISTA <> 0
     AND CODVEICULO <> 0
   AND (
      (TRUNC(AD_DTINCLUSAO) >= TO_DATE(TO_CHAR($P{DTAINICIAL}, 'DD/MM/YYYY'), 'DD/MM/YYYY')
       AND TRUNC(AD_DTINCLUSAO) <= TO_DATE(TO_CHAR($P{DTFINAL}, 'DD/MM/YYYY'), 'DD/MM/YYYY'))
      OR $P{DTAINICIAL} IS NULL
    )
     AND VLRFRETE <>'0'
   GROUP BY ORDEMCARGA,
            CODPARCMOTORISTA),

     FretePorMotorista AS
  (SELECT CODPARCMOTORISTA,
          SUM(VLRFRETE) AS VLRFRETE_TOTAL_MOTORISTA
   FROM FretePorOrdem
   GROUP BY CODPARCMOTORISTA)

SELECT ORD.CODPARCMOTORISTA,
       TRANSP.NOMEPARC                              AS MOTORISTA,
       ORD.ORDEMCARGA,
       ORD.AD_DTINCLUSAO,
       PAR.NOMEPARC                                 AS CLIENTE,
       CAB.NUMNOTA,
       FPOR.VLRFRETE,
       FPM.VLRFRETE_TOTAL_MOTORISTA
FROM TGFORD ORD
LEFT JOIN TGFCAB CAB               ON ORD.ORDEMCARGA = CAB.ORDEMCARGA
LEFT JOIN TGFPAR PAR               ON CAB.CODPARC   = PAR.CODPARC
INNER JOIN TGFPAR TRANSP           ON ORD.CODPARCMOTORISTA = TRANSP.CODPARC
INNER JOIN FretePorOrdem FPOR      ON ORD.ORDEMCARGA = FPOR.ORDEMCARGA
                                  AND ORD.CODPARCMOTORISTA = FPOR.CODPARCMOTORISTA
INNER JOIN FretePorMotorista FPM   ON ORD.CODPARCMOTORISTA = FPM.CODPARCMOTORISTA
WHERE ORD.CODPARCMOTORISTA <> 0
  AND ORD.CODVEICULO <> 0
 AND (
      (TRUNC(ORD.AD_DTINCLUSAO) >= TO_DATE(TO_CHAR($P{DTAINICIAL}, 'DD/MM/YYYY'), 'DD/MM/YYYY')
       AND TRUNC(ORD.AD_DTINCLUSAO) <= TO_DATE(TO_CHAR($P{DTFINAL}, 'DD/MM/YYYY'), 'DD/MM/YYYY'))
      OR $P{DTAINICIAL} IS NULL
    )
  AND (ORD.CODPARCMOTORISTA = $P{CODMOTORISTA}
       OR $P{CODMOTORISTA} IS NULL)
ORDER BY TRANSP.NOMEPARC,
         ORD.ORDEMCARGA]]>
	</queryString>
