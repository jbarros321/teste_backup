<?xml version="1.0" encoding="utf-8"?>
<controls:DefaultSankhyaApplication preloader="br.com.sankhya.controls.managers.CustomPreloader"   
	xmlns:compactpanel="br.com.sankhya.controls.compactpanel.*"
	xmlns:mx="http://www.adobe.com/2006/mxml" 
	xmlns:ui="br.com.sankhya.db.ui.*" 
	xmlns:controls="br.com.sankhya.controls.*" 
	xmlns:db="br.com.sankhya.db.*"
	xmlns:datagrid="br.com.sankhya.controls.datagrid.*"
	xmlns:dwf="br.com.sankhya.dwf.*"
	xmlns:gridRateioHolding="br.com.sankhya.extensions.rateio.holding.*"
	implements="br.com.sankhya.db.IDBCriteriaProvider"
	layout="vertical"
	creationComplete="creationComplete()">

	<mx:Script>
		<![CDATA[
			import br.com.sankhya.db.IDBCriteria;
			import br.com.sankhya.db.DBCriteria;
			import br.com.sankhya.dwf.LiteralCriteria;
			import br.com.sankhya.extensions.rateio.holding.GridRateioHolding;
			import br.com.sankhya.util.MessageUtils;
			import mx.controls.Button;
			import mx.utils.ObjectUtil;
			import br.com.sankhya.util.http.ServiceProxy;
			import mx.formatters.DateFormatter;
			import br.com.sankhya.util.datetime.DateUtil;
			
			[Bindable][Embed(source="/assets/btnSimSintetico.png")] 
			private var _btnSimSinteticoImg:Class;
			
			[Bindable][Embed(source="/assets/btnSimAnalitico.png")] 
			private var _btnSimAnaliticoImg:Class;
			
			private function creationComplete():void {
				loadState();
				injetarBotoes();
				gridRateio.refreshTopBars();
				
				codTipoOperacao.getEnvironmentCriteria = function():Array{
					return [new LiteralCriteria(" (this.TIPMOV = 'I' OR this.CODTIPOPER = 0) ")];
				};
			} 
			
			private function injetarBotoes():void {
				injetarBotaoSimulacaoAnalitica();
				injetarBotaoSimulacaoSintetica();
				injetarBotaoGerarSintetico();
			}
			
			private function injetarBotaoSimulacaoAnalitica():void {
				var btnSimulaAnalitico:Button = new Button();
				btnSimulaAnalitico.addEventListener(MouseEvent.CLICK, function():void {
					if(camposValidosParaSimulacoes()) {
						gridRateio.datIni = DateUtil.getDateObject(periodoBaixa.dataInicialText);
						gridRateio.datFim = DateUtil.getDateObject(periodoBaixa.dataFinalText);
						gridRateio.ordem = parseInt(ordem.getData().toString());
						gridRateio.calcImpRetidos = cbxCalcImpRetidos.selected;
						gridRateio.ehRepasse = true;
						gridRateio.simularAnalitico();
						saveState();
					}
				});
				btnSimulaAnalitico.label = "Simular Analítico";
				btnSimulaAnalitico.setStyle("icon", _btnSimAnaliticoImg);
				btnSimulaAnalitico.height = 22;			
				gridRateio.topBars = [btnSimulaAnalitico];
			}
			
			private function injetarBotaoSimulacaoSintetica():void {
				var btnSimulaSintetico:Button = new Button();
				btnSimulaSintetico.addEventListener(MouseEvent.CLICK, function():void {
					if(camposValidosParaSimulacoes()) {
						gridRateio.datIni = DateUtil.getDateObject(periodoBaixa.dataInicialText);
						gridRateio.datFim = DateUtil.getDateObject(periodoBaixa.dataFinalText);
						gridRateio.ordem = parseInt(ordem.getData().toString());
						gridRateio.calcImpRetidos = cbxCalcImpRetidos.selected;
						gridRateio.ehRepasse = true;
						gridRateio.simularSintetico();
						saveState();
					}
				});
				btnSimulaSintetico.label = "Simular Sintético";
				btnSimulaSintetico.setStyle("icon", _btnSimSinteticoImg);
				btnSimulaSintetico.height = 22;			
				gridRateio.topBars = [btnSimulaSintetico];
			}
			
			private function injetarBotaoGerarSintetico():void {
				var btnGeraSintetico:Button = new Button();
				btnGeraSintetico.addEventListener(MouseEvent.CLICK, function():void {
					if(camposValidosParaGeracao()) {
						MessageUtils.showAlertWithConfirm(
							MessageUtils.TITLE_CONFIRMATION,
							"Deseja prosseguir com a geração?", 
							function():void {
								gridRateio.datIni = DateUtil.getDateObject(periodoBaixa.dataInicialText);
								gridRateio.datFim = DateUtil.getDateObject(periodoBaixa.dataFinalText);
								gridRateio.ordem = parseInt(ordem.getData().toString());
								gridRateio.calcImpRetidos = cbxCalcImpRetidos.selected;
								gridRateio.ehRepasse = true;
								gridRateio.datNegociacao = new Date(dtNegociacao.getData());
								gridRateio.datVencimento = new Date(dtVencimento.getData());
								gridRateio.codTipTitulo = parseInt(codTipoTitulo.getData().toString());
								gridRateio.codTipOperacao = parseInt(codTipoOperacao.getData().toString());
								gridRateio.historico = historico.text;
								gridRateio.gerarSintetico();
								saveState();
							}
						);
					}
				});
				btnGeraSintetico.label = "Gerar Sintético";
				btnGeraSintetico.styleName = "btnProcess";		
				btnGeraSintetico.height = 22;					
				gridRateio.topBars = [btnGeraSintetico];
			}
			
			public function isCriteriaProviderLoaded(callThisOnLoad:Function):Boolean{
				return true;
			}
			
			public function getCriteria():IDBCriteria {
				var dbCriteria:DBCriteria = new DBCriteria();
				return dbCriteria;	
			}
			
			private function camposValidosParaSimulacoes():Boolean{
				if( periodoBaixa != null && (periodoBaixa.dataInicialText == "" || periodoBaixa.dataFinalText == "") ) {
						MessageUtils.showError(MessageUtils.TITLE_ERROR,"Informe o Período de Baixa.");
						return false;
				}
				
				var dataInicial:Date = DateUtil.getDateObject(periodoBaixa.dataInicialText);
				var dataFinal:Date = DateUtil.getDateObject(periodoBaixa.dataFinalText);
				if(ObjectUtil.dateCompare(dataInicial,dataFinal) > 0) {
					MessageUtils.showError(MessageUtils.TITLE_ERROR,"Data Inicial no Período de Baixa não pode ser maior que a Data Final.");
				}
				
				if(ordem != null && ordem.getData() == null) {
					MessageUtils.showError(MessageUtils.TITLE_ERROR,"Informe a Ordem.");
					return false;
				}
				return true;
			}
			
			private function camposValidosParaGeracao():Boolean {
				if(camposValidosParaSimulacoes()) {
					if(dtNegociacao != null && dtNegociacao.text == "") {
						MessageUtils.showError(MessageUtils.TITLE_ERROR,"Para esta operação informe a Data de Negociação.");
						return false;
					}
					if(dtVencimento != null && dtVencimento.text == "") {
						MessageUtils.showError(MessageUtils.TITLE_ERROR,"Para esta operação informe a Data de Vencimento.");
						return false;
					}
					if(codTipoTitulo != null && codTipoTitulo.getData() == null) {
						MessageUtils.showError(MessageUtils.TITLE_ERROR,"Para esta operação informe o Tipo Título.");
						return false;
					}
					if(codTipoOperacao != null && codTipoOperacao.getData() == null) {
						MessageUtils.showError(MessageUtils.TITLE_ERROR,"Para esta operação informe o Tipo Operação.");
						return false;
					}
					return true;
				}
				return false;
			}
			
			private function saveState():void {
				var config:XML =
				<config chave={getApplicationResourceID() + "_estado"} tipo="T">
					<staticFilter />
					<pref />
				</config>;
				
				if (dtNegociacao.text != "") {
					config.staticFilter.@dtNegociacao = dtNegociacao.text;
				}
				if(dtVencimento.text != "") {
					config.staticFilter.@dtVencimento = dtVencimento.text;
				}
				if(codTipoTitulo.getData() != null) {
					config.staticFilter.@codTipoTitulo = codTipoTitulo.getData();
				}
				if(codTipoOperacao.getData() != null) {
					config.staticFilter.@codTipoOperacao = codTipoOperacao.getData();
				}
				if(historico.text != "") {
					config.staticFilter.@historico = historico.text;
				}
				config.staticFilter.@calcImpRetidos = cbxCalcImpRetidos.selected;
				
				ServiceProxy.callService(
					"mge@SystemUtilsSP.saveConf",
					config,
					function(param:*, result:XML):void {
					}, 
					true
				);
			}
			
			private function loadState():void {
				ServiceProxy.callService(
					"mge@SystemUtilsSP.getConf",
					<config chave={getApplicationResourceID() + "_estado"} tipo="T" />,
					function(params:*, response:XML):void{
						if(response.responseBody.children().length() > 0) {
							var staticFilter:XML = response.responseBody.config.staticFilter[0];
							if (staticFilter.hasOwnProperty("@dtNegociacao")) {
								dtNegociacao.text = staticFilter.@dtNegociacao.toString();
							}
							if (staticFilter.hasOwnProperty("@dtVencimento")) {
								dtVencimento.text = staticFilter.@dtVencimento.toString();
							}
							if (staticFilter.hasOwnProperty("@codTipoTitulo")) {
								codTipoTitulo.setData(staticFilter.@codTipoTitulo);
								codTipoTitulo.updateDescription();
							}
							if (staticFilter.hasOwnProperty("@codTipoOperacao")) {
								codTipoOperacao.setData(staticFilter.@codTipoOperacao);
								codTipoOperacao.updateDescription();
							}
							if (staticFilter.hasOwnProperty("@historico")) {
								historico.text = staticFilter.@historico.toString();
							}
							if (staticFilter.hasOwnProperty("@calcImpRetidos")) {
								cbxCalcImpRetidos.selected = staticFilter.@calcImpRetidos.toString() == "true" ? true : false;
							}
						}
					}, 
					true
				);
			}
			
		]]>
	</mx:Script>
	
	<mx:HDividedBox width="100%" height="100%" horizontalGap="3">
		<compactpanel:SanCompactPanel id="compac"
			height="100%"
			direction="horizontal"
			heightBtnShowHide="100"
			positionButtonShowHide="afterContainer"
			widthBtnShowHide="8"
			>
			<compactpanel:content>
				<mx:VBox width="100%" height="100%" verticalGap="4">
					<mx:Accordion id="sanfona"
							width="100%"
							height="100%"
							borderSides="left top right"
							selectedIndex="1"
							>
						<mx:VBox width="100%"
							label="Atributos"
							paddingBottom="5"
							paddingLeft="5"
							paddingRight="5"
							paddingTop="5"
							verticalGap="1"
							>
							<mx:FormItem required="true" label="Período de Baixa:"/>
							<controls:Period id="periodoBaixa"/>
							<mx:Spacer height="10"/>
							<mx:FormItem required="true" label="Ordem (0 = todas):"/>
							<ui:DBNumericInput id="ordem" precision="0" dataValue="0"/>
							<mx:Spacer height="10"/>
							<mx:FormItem label="Negociação:"/>
							<ui:DBDateField id="dtNegociacao"/>
							<mx:Spacer height="10"/>
							<mx:FormItem label="Vencimento:"/>
							<ui:DBDateField id="dtVencimento"/>
							<mx:Spacer height="10"/>
							<mx:FormItem label="Tipo Título:"/>
							<ui:DBPesquisa id="codTipoTitulo" entityName="TipoTitulo" fieldName="CODTIPTIT" />
							<mx:Spacer height="10"/>
							<mx:FormItem label="Tipo Operação:"/>
							<ui:DBPesquisa id="codTipoOperacao" entityName="TipoOperacao" fieldName="CODTIPOPER"/>
							<mx:Spacer height="10"/>
							<mx:FormItem label="Histórico:"/>
							<ui:DBTextInput id="historico"/>
							<mx:Spacer height="10"/>
							<ui:DBCheckBox id="cbxCalcImpRetidos" label="Calcular sobre impostos retidos"/>
						</mx:VBox>
					</mx:Accordion>
				</mx:VBox>
			</compactpanel:content>
		</compactpanel:SanCompactPanel>
		<gridRateioHolding:GridRateioHolding id="gridRateio"/>			
	</mx:HDividedBox>
</controls:DefaultSankhyaApplication>