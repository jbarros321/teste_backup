<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GuiaAcertoDesligadoSatis" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b5a1f6a1-1234-4a5b-9c8d-e7f6a5b4c3d2">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_NUFECH" class="java.math.BigDecimal">
		<property name="nomeTabela" value="AD_DBFECHCOMFIN"/>
		<parameterDescription><![CDATA[Nro. Fechamento]]></parameterDescription>
	</parameter>
	<parameter name="P_SEQUENCIA" class="java.math.BigDecimal">
		<property name="nomeTabela" value="AD_DBFECHCOMFIN"/>
		<parameterDescription><![CDATA[Sequência]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    FIN.NUFECH,
    VEN.CODVEND,
    VEN.APELIDO,
    NVL(FIN.DIASTRAB, 0) AS DIASTRAB,
    NVL(FIN.REMFIXA, 0) AS REMFIXA,
    ROUND(NVL(FIN.VALOR, 0) - NVL(FIN.VLRADTCOMP, 0), 2) AS COMISSAO_MES,
    (SELECT NVL(SUM(VLRCOM), 0) FROM AD_DBFECHCOMNOTASA WHERE NUFECH = FIN.NUFECH AND CODVEND = FIN.CODVEND) AS COMISSAO_FUTURA,
    (NVL(FIN.EXTRA, 0) + NVL(FIN.REEMBOLSO, 0)) AS OUTROS_VALORES,
    (NVL(FIN.ADIANTAMENTO, 0) + NVL(FIN.ADIANTFIXO, 0)) AS ADIANTAMENTOS,
    (
        NVL(FIN.REMFIXA, 0) + 
        ROUND(NVL(FIN.VALOR, 0) - NVL(FIN.VLRADTCOMP, 0), 2) + 
        (SELECT NVL(SUM(VLRCOM), 0) FROM AD_DBFECHCOMNOTASA WHERE NUFECH = FIN.NUFECH AND CODVEND = FIN.CODVEND) + 
        (NVL(FIN.EXTRA, 0) + NVL(FIN.REEMBOLSO, 0)) - 
        (NVL(FIN.ADIANTAMENTO, 0) + NVL(FIN.ADIANTFIXO, 0))
    ) AS VALOR_LIQUIDO
FROM 
    AD_DBFECHCOMFIN FIN 
INNER JOIN 
    TGFVEN VEN ON FIN.CODVEND = VEN.CODVEND
WHERE 
    FIN.NUFECH = $P{P_NUFECH}
    AND FIN.SEQUENCIA = $P{P_SEQUENCIA}]]>
	</queryString>
	<field name="NUFECH" class="java.math.BigDecimal"/>
	<field name="CODVEND" class="java.math.BigDecimal"/>
	<field name="APELIDO" class="java.lang.String"/>
	<field name="DIASTRAB" class="java.math.BigDecimal"/>
	<field name="REMFIXA" class="java.math.BigDecimal"/>
	<field name="COMISSAO_MES" class="java.math.BigDecimal"/>
	<field name="COMISSAO_FUTURA" class="java.math.BigDecimal"/>
	<field name="OUTROS_VALORES" class="java.math.BigDecimal"/>
	<field name="ADIANTAMENTOS" class="java.math.BigDecimal"/>
	<field name="VALOR_LIQUIDO" class="java.math.BigDecimal"/>
