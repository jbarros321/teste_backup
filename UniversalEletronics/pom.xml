<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.universaleletronic</groupId>
    <artifactId>geraArquivoremessa_Vs1</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <name>Gera Arquivo Remessa - Universal Eletronics</name>
    <description>Geração de arquivo de remessa bancária</description>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <profiles>
        <profile>
            <id>default</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <maven.model.validation>false</maven.model.validation>
            </properties>
        </profile>
        
        <profile>
            <id>skip-sankhya-deps</id>
            <activation>
                <property>
                    <name>skip.sankhya.deps</name>
                    <value>true</value>
                </property>
            </activation>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>br.com.sankhya.local</groupId>
            <artifactId>sankhyaw-extensions-local</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/SankhyaW-extensions.jar</systemPath>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>br.com.sankhya.local</groupId>
            <artifactId>jape-local</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/jape.jar</systemPath>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>br.com.sankhya.local</groupId>
            <artifactId>mge-modelcore-local</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/mge-modelcore.jar</systemPath>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>br.com.sankhya.local</groupId>
            <artifactId>sanutil-local</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/sanutil.jar</systemPath>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>br.com.sankhya.local</groupId>
            <artifactId>sanws-local</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/sanws.jar</systemPath>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <finalName>${project.artifactId}</finalName>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
