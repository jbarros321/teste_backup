# Cifra Ministério — copie para .env.local e preencha com o seu projeto Supabase.
# Dashboard → Project Settings → API.
#
# Só entram aqui chaves PÚBLICAS. A service_role key NUNCA vai para o frontend:
# ela ignora o RLS e daria acesso a todas as igrejas.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
