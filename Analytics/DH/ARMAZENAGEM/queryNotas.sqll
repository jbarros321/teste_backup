SELECT MAX(G.ID) AS ID, G.NUNOTA, MAX(G.NUMNOTA) AS NUMNOTA, (SELECT COUNT(DISTINCT I.CODPROD) FROM IMP_NOTAS_ARMAZ I WHERE I.NUNOTA = G.NUNOTA) AS QTD_PRODUTOS, DATE_FORMAT(MAX(G.DTNEG), '%d/%m/%Y') AS DTNEG, MIN(COALESCE(G.ENTREGUE, 0)) AS ENTREGUE, DATE_FORMAT(MAX(G.DATA_ENTREGA), '%d/%m/%Y %H:%i') AS DT_ENTREGA FROM GESTAO_NOTAS_APROVACAO G WHERE G.CODPARC = :VAR_PARCEIRO_SELECIONADO AND G.DTNEG BETWEEN :VAR_PERIODO_INICIO AND :VAR_PERIODO_FIM AND NOT EXISTS (SELECT 1 FROM NOTA_ARMAZ_APROVAR_ESPELHO espelho WHERE espelho.NUNOTA = G.NUNOTA) GROUP BY G.NUNOTA ORDER BY MAX(G.DTNEG), G.NUNOTA