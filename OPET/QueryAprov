SELECT
     (SELECT TOKEN FROM AD_TOKEAPI) AS TOKEN,  
    ud.EMPRESA AS CODEMP,
    DATE_FORMAT(ud.DTREF, '%d/%m/%Y') AS DTREF,
    op.ID_TIPO_ORCAMENTO AS CODTIPOORCAMENTO,
    ud.PROJETO  AS CODPROJ,
    ud.CR       AS CODCENCUS,
    ud.NATUREZA AS CODNAT,
    CASE 
        WHEN ud.TIPNAT = 'R' THEN ud.VALOR 
        ELSE 0 
    END AS PREVREC,
    CASE 
        WHEN ud.TIPNAT = 'D' THEN ud.VALOR 
        ELSE 0 
    END AS PREVDESP
FROM
(
    SELECT
        ID_ORCAMENTO_PAI,
        EMPRESA,
        PROJETO,
        CR,
        NATUREZA,
        TIPNAT,
        STR_TO_DATE(CONCAT('01-01-', ANO), '%d-%m-%Y') AS DTREF,
        JANEIRO AS VALOR
    FROM ORCAMENTO_APROVADO
    WHERE JANEIRO IS NOT NULL AND JANEIRO <> 0
    AND IMPORTADO <> 'S'

    UNION ALL

    SELECT
        ID_ORCAMENTO_PAI,
        EMPRESA,
        PROJETO,
        CR,
        NATUREZA,
        TIPNAT,
        STR_TO_DATE(CONCAT('01-02-', ANO), '%d-%m-%Y') AS DTREF,
        FEVEREIRO AS VALOR
    FROM ORCAMENTO_APROVADO
    WHERE FEVEREIRO IS NOT NULL AND FEVEREIRO <> 0
    AND IMPORTADO <> 'S'

    UNION ALL

    SELECT
        ID_ORCAMENTO_PAI,
        EMPRESA,
        PROJETO,
        CR,
        NATUREZA,
        TIPNAT,
        STR_TO_DATE(CONCAT('01-03-', ANO), '%d-%m-%Y') AS DTREF,
        MARCO AS VALOR
    FROM ORCAMENTO_APROVADO
    WHERE MARCO IS NOT NULL AND MARCO <> 0
    AND IMPORTADO <> 'S'

    UNION ALL

    SELECT
        ID_ORCAMENTO_PAI,
        EMPRESA,
        PROJETO,
        CR,
        NATUREZA,
        TIPNAT,
        STR_TO_DATE(CONCAT('01-04-', ANO), '%d-%m-%Y') AS DTREF,
        ABRIL AS VALOR
    FROM ORCAMENTO_APROVADO
    WHERE ABRIL IS NOT NULL AND ABRIL <> 0
    AND IMPORTADO <> 'S'

    UNION ALL

    SELECT
        ID_ORCAMENTO_PAI,
        EMPRESA,
        PROJETO,
        CR,
        NATUREZA,
        TIPNAT,
        STR_TO_DATE(CONCAT('01-05-', ANO), '%d-%m-%Y') AS DTREF,
        MAIO AS VALOR
    FROM ORCAMENTO_APROVADO
    WHERE MAIO IS NOT NULL AND MAIO <> 0
    AND IMPORTADO <> 'S'

    UNION ALL

    SELECT
        ID_ORCAMENTO_PAI,
        EMPRESA,
        PROJETO,
        CR,
        NATUREZA,
        TIPNAT,
        STR_TO_DATE(CONCAT('01-06-', ANO), '%d-%m-%Y') AS DTREF,
        JUNHO AS VALOR
    FROM ORCAMENTO_APROVADO
    WHERE JUNHO IS NOT NULL AND JUNHO <> 0
    AND IMPORTADO <> 'S'

    UNION ALL

    SELECT
        ID_ORCAMENTO_PAI,
        EMPRESA,
        PROJETO,
        CR,
        NATUREZA,
        TIPNAT,
        STR_TO_DATE(CONCAT('01-07-', ANO), '%d-%m-%Y') AS DTREF,
        JULHO AS VALOR
    FROM ORCAMENTO_APROVADO
    WHERE JULHO IS NOT NULL AND JULHO <> 0
    AND IMPORTADO <> 'S'

    UNION ALL

    SELECT
        ID_ORCAMENTO_PAI,
        EMPRESA,
        PROJETO,
        CR,
        NATUREZA,
        TIPNAT,
        STR_TO_DATE(CONCAT('01-08-', ANO), '%d-%m-%Y') AS DTREF,
        AGOSTO AS VALOR
    FROM ORCAMENTO_APROVADO
    WHERE AGOSTO IS NOT NULL AND AGOSTO <> 0
    AND IMPORTADO <> 'S'

    UNION ALL

    SELECT
        ID_ORCAMENTO_PAI,
        EMPRESA,
        PROJETO,
        CR,
        NATUREZA,
        TIPNAT,
        STR_TO_DATE(CONCAT('01-09-', ANO), '%d-%m-%Y') AS DTREF,
        SETEMBRO AS VALOR
    FROM ORCAMENTO_APROVADO
    WHERE SETEMBRO IS NOT NULL AND SETEMBRO <> 0
    AND IMPORTADO <> 'S'

    UNION ALL

    SELECT
        ID_ORCAMENTO_PAI,
        EMPRESA,
        PROJETO,
        CR,
        NATUREZA,
        TIPNAT,
        STR_TO_DATE(CONCAT('01-10-', ANO), '%d-%m-%Y') AS DTREF,
        OUTUBRO AS VALOR
    FROM ORCAMENTO_APROVADO
    WHERE OUTUBRO IS NOT NULL AND OUTUBRO <> 0
    AND IMPORTADO <> 'S'

    UNION ALL

    SELECT
        ID_ORCAMENTO_PAI,
        EMPRESA,
        PROJETO,
        CR,
        NATUREZA,
        TIPNAT,
        STR_TO_DATE(CONCAT('01-11-', ANO), '%d-%m-%Y') AS DTREF,
        NOVEMBRO AS VALOR
    FROM ORCAMENTO_APROVADO
    WHERE NOVEMBRO IS NOT NULL AND NOVEMBRO <> 0
    AND IMPORTADO <> 'S'

    UNION ALL

    SELECT
        ID_ORCAMENTO_PAI,
        EMPRESA,
        PROJETO,
        CR,
        NATUREZA,
        TIPNAT,
        STR_TO_DATE(CONCAT('01-12-', ANO), '%d-%m-%Y') AS DTREF,
        DEZEMBRO AS VALOR
    FROM ORCAMENTO_APROVADO
    WHERE DEZEMBRO IS NOT NULL AND DEZEMBRO <> 0
    AND IMPORTADO <> 'S'

) AS ud
JOIN ORCAMENTO_PAI op
     ON ud.ID_ORCAMENTO_PAI = op.ID
WHERE
(
       CAST(ud.EMPRESA  AS CHAR) LIKE CONCAT('%', IFNULL(UPPER(:VAR_SEARCH_APROVADOS), ''), '%')
    OR CAST(ud.PROJETO  AS CHAR) LIKE CONCAT('%', IFNULL(UPPER(:VAR_SEARCH_APROVADOS), ''), '%')
    OR CAST(ud.CR       AS CHAR) LIKE CONCAT('%', IFNULL(UPPER(:VAR_SEARCH_APROVADOS), ''), '%')
    OR CAST(ud.NATUREZA AS CHAR) LIKE CONCAT('%', IFNULL(UPPER(:VAR_SEARCH_APROVADOS), ''), '%')
)
ORDER BY
    ud.DTREF,
    ud.EMPRESA,
    CODPROJ,
    CODCENCUS,
    CODNAT