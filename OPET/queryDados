WITH DADOS_BASE AS (    SELECT        TO_CHAR(O.DTREF, 'YYYY-MM') AS MES_ANO,        N.DESCRNAT AS NATUREZA_NOME,        P.IDENTIFICACAO AS PROJETO_NOME,        O.PREVREC AS ORCADO_RECEITA,        O.PREVDESP AS ORCADO_DESPESA,        O.BAIXA_REC AS REALIZADO_RECEITA,        O.BAIXA_DESP AS REALIZADO_DESPESA,        O.CODEMP, O.CODPROJ, O.CODCENCUS, O.CODNAT    FROM        Orcamentos O    LEFT JOIN Natureza N ON O.CODNAT = N.CODNAT    LEFT JOIN Projetos P ON O.CODPROJ = P.CODPROJ    WHERE        (O.DTREF >= TO_DATE(SUBSTR(:VAR_ORA_DT_INI, 1, 10), 'YYYY-MM-DD') OR :VAR_ORA_DT_INI IS NULL OR :VAR_ORA_DT_INI = '')        AND (O.DTREF < TO_DATE(SUBSTR(:VAR_ORA_DT_FIM, 1, 10), 'YYYY-MM-DD') + 1 OR :VAR_ORA_DT_FIM IS NULL OR :VAR_ORA_DT_FIM = '')        AND (:VAR_ORA_EMP IS NULL OR LTRIM(RTRIM(:VAR_ORA_EMP)) = '' OR INSTR(',' || :VAR_ORA_EMP || ',', ',' || O.CODEMP || ',') > 0)        AND (:VAR_ORA_PROJ IS NULL OR LTRIM(RTRIM(:VAR_ORA_PROJ)) = '' OR INSTR(',' || :VAR_ORA_PROJ || ',', ',' || O.CODPROJ || ',') > 0)        AND (:VAR_ORA_CR IS NULL OR LTRIM(RTRIM(:VAR_ORA_CR)) = '' OR INSTR(',' || :VAR_ORA_CR || ',', ',' || O.CODCENCUS || ',') > 0)        AND (:VAR_ORA_NAT IS NULL OR LTRIM(RTRIM(:VAR_ORA_NAT)) = '' OR INSTR(',' || :VAR_ORA_NAT || ',', ',' || O.CODNAT || ',') > 0))SELECT    MES_ANO, NATUREZA_NOME, PROJETO_NOME,    CODEMP, CODPROJ, CODCENCUS, CODNAT,    SUM(ORCADO_RECEITA) AS ORCADO_RECEITA,    SUM(ORCADO_DESPESA) AS ORCADO_DESPESA,    SUM(REALIZADO_RECEITA) AS REALIZADO_RECEITA,    SUM(REALIZADO_DESPESA) AS REALIZADO_DESPESAFROM DADOS_BASEGROUP BY MES_ANO, NATUREZA_NOME, PROJETO_NOME, CODEMP, CODPROJ, CODCENCUS, CODNATORDER BY NATUREZA_NOME, PROJETO_NOME, MES_ANO