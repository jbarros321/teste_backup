queryAgrupadores

SELECT D.CODAGRUP, D.DESCAGRUP /*, [SUM(CASE WHEN...)] AS MES_1, [SUM(CASE WHEN...)] AS MES_2 ... */ FROM AD_VW_BASEDRE D WHERE D.DTNEG BETWEEN TO_DATE(SUBSTR(COALESCE(:VAR_DRE_DT_INI, '2025-01-01 00:00:00'), 1, 10), 'YYYY-MM-DD') AND TO_DATE(SUBSTR(COALESCE(:VAR_DRE_DT_FIM, '2025-12-31 23:59:59'), 1, 10), 'YYYY-MM-DD') AND (:VAR_DRE_NATUREZA IS NULL OR :VAR_DRE_NATUREZA = '' OR INSTR(',' || :VAR_DRE_NATUREZA || ',', ',' || TO_CHAR(D.CODNAT) || ',') > 0) AND (:VAR_DRE_PROVISAO IS NULL OR :VAR_DRE_PROVISAO = '' OR INSTR(',' || :VAR_DRE_PROVISAO || ',', ',' || D.PROVISAO || ',') > 0) AND (:VAR_DRE_CONCILIADO IS NULL OR :VAR_DRE_CONCILIADO = '' OR INSTR(',' || :VAR_DRE_CONCILIADO || ',', ',' || D.CONCILIADO || ',') > 0) GROUP BY D.CODAGRUP, D.DESCAGRUP ORDER BY D.CODAGRUP