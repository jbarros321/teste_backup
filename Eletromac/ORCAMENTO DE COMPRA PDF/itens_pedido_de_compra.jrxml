	<field name="VLRUNIT" class="java.lang.Double"/>
	<field name="VLRDESC" class="java.math.BigDecimal"/>
	<field name="VLRTOT" class="java.math.BigDecimal"/>
	<field name="PERCDESC" class="java.math.BigDecimal"/>
	<field name="ALIQICMS" class="java.math.BigDecimal"/>
	<field name="ALIQIPI" class="java.math.BigDecimal"/>
	<variable name="VLRTOT_1" class="java.math.BigDecimal" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[$F{VLRTOT}]]></variableExpression>
	</variable>
	<variable name="QTDE_1" class="java.math.BigDecimal" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[$F{QTDE}]]></variableExpression>
	</variable>
