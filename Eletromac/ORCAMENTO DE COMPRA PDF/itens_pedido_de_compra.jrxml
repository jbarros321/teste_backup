<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="itens_pedido_de_compra" language="groovy" pageWidth="555" pageHeight="802" columnWidth="545" leftMargin="0" rightMargin="10" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.9487171000000014"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PK_NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT   DECODE (ITE.CODEXEC, 0, '', ' ') AS CODEXEC,
         DECODE (ITE.CODEXEC,
                 0, '',
                 ' ' || INITCAP (TRIM (TO_CHAR (VEN.APELIDO)))
                ) AS EXECUTANTE,
		 TRIM (TO_CHAR (ITE.SEQUENCIA)) AS ITEM,
         TRIM (TO_CHAR (PRO.CODPROD)) AS CODIGO,
         TRIM (TO_CHAR (PRO.DESCRPROD))
         ||
         ' '
         ||
         TRIM (TO_CHAR(NVL(PRO.COMPLDESC, ' ')))
         ||
         ' '
         ||
         TRIM (TO_CHAR (ITE.CONTROLE)) AS DESCRICAO,
         TRIM (TO_CHAR (PRO.MARCA)) AS MARCA,
         TRIM (TO_CHAR (PRO.CODVOL)) AS UN,
         TO_NUMBER (ITE.QTDNEG) AS QTDE,
         ITE.VLRUNIT AS VLRUNIT, TO_NUMBER (ITE.VLRDESC) AS VLRDESC,
         TO_NUMBER (SUM (ITE.VLRTOT - ITE.VLRDESC)) AS VLRTOT,
         TO_NUMBER (ITE.PERCDESC) AS PERCDESC,
         CAST (Snk_Dividir(ITE.ALIQICMS, 100) AS NUMBER) AS ALIQICMS,
         CAST (Snk_Dividir(ITE.ALIQIPI, 100) AS NUMBER) AS ALIQIPI
    FROM TGFPRO PRO, TGFITE ITE, TGFVEN VEN
   WHERE PRO.CODPROD = ITE.CODPROD
     AND VEN.CODVEND = ITE.CODEXEC
     AND ITE.NUNOTA = $P{PK_NUNOTA}
GROUP BY VEN.APELIDO,
         PRO.CODPROD,
         PRO.DESCRPROD,
         PRO.COMPLDESC,
         ITE.CONTROLE,
         PRO.MARCA,
         PRO.CODVOL,
         ITE.QTDNEG,
         ITE.VLRUNIT,
         ITE.VLRDESC,
         ITE.PERCDESC,
         ITE.CODEXEC,
         ITE.SEQUENCIA,
         ITE.ALIQICMS,
         ITE.ALIQIPI
ORDER BY ITE.SEQUENCIA,ITE.CODEXEC]]>
	</queryString>
	<field name="CODEXEC" class="java.lang.String"/>
	<field name="EXECUTANTE" class="java.lang.String"/>
	<field name="ITEM" class="java.lang.String"/>
	<field name="CODIGO" class="java.lang.String"/>
	<field name="DESCRICAO" class="java.lang.String"/>
	<field name="MARCA" class="java.lang.String"/>
