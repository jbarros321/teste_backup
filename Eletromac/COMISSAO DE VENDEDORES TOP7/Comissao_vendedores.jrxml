				</textField>
				<textField pattern="¤ #,##0.00" isBlankWhenNull="true">
					<reportElement x="230" y="0" width="65" height="13"/>
					<textElement verticalAlignment="Middle">
						<font fontName="SansSerif" size="8" isBold="true"/>
					</textElement>
					<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{Valor Prazo_1}]]></textFieldExpression>
				</textField>
				<textField pattern="¤ #,##0.00" isBlankWhenNull="true">
