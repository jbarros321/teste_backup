					<reportElement key="subtotal" x="0" y="13" width="555" height="55" isPrintWhenDetailOverflows="true"/>
					<subreportParameter name="Data Inicial">
						<subreportParameterExpression><![CDATA[$P{Data Inicial}]]></subreportParameterExpression>
					</subreportParameter>
					<subreportParameter name="Data Final">
