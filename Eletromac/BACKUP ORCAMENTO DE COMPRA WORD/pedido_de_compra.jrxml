<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="pedido_de_compra" language="groovy" pageWidth="595" pageHeight="842" columnWidth="545" leftMargin="30" rightMargin="20" topMargin="30" bottomMargin="20" whenResourceMissingType="Empty">
	<property name="ireport.zoom" value="1.6105100000000017"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="PK_NUNOTA" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PDIR_MODELO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["/"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT CAB.CODVEND AS CODVEND, PAR.CODPARC AS CODPARC,
                CAB.CODEMP AS CODEMP, EMP.RAZAOSOCIAL AS RAZAOSOCIAL,
                DECODE (CAB.DTPREVENT,
                        NULL, ' ',
                        TRIM (TO_CHAR (CAB.DTPREVENT))
                       ) AS ENTREGA,
                   SUBSTR (EMP.CGC, 1, 2)
                || '.'
                || SUBSTR (EMP.CGC, 3, 3)
                || '.'
                || SUBSTR (EMP.CGC, 6, 3)
                || '/'
                || SUBSTR (EMP.CGC, 9, 4)
                || '-'
                || SUBSTR (EMP.CGC, 13) AS CNPJEMPRESA,
                EMP.INSCESTAD AS IE,
                INITCAP (TRIM (EMP.NOMEFANTASIA)) AS NOMEFANTASIA,
                   INITCAP (TRIM (ENDE.TIPO))
                || '. '
                || INITCAP (TRIM (ENDE.NOMEEND))
                || ', '
                || EMP.NUMEND
                || ', Bairro: '
                || INITCAP (TRIM (BAIE.NOMEBAI))
                || ', Cidade: '
                || INITCAP (TRIM (CIDE.NOMECID))
                || '-'
                || TRIM (UFSE.UF)
                || ', Cep: '
                || SUBSTR (TRIM (EMP.CEP), 1, 2)
                || '.'
                || SUBSTR (TRIM (EMP.CEP), 3, 3)
                || '-'
                || SUBSTR (TRIM (EMP.CEP), 6, 3) AS ENDERECOEMPRESA,
                TRIM (TO_CHAR (CAB.NUMNOTA)) AS NUMNOTA,
                   TRIM (TO_CHAR (SYSDATE, 'DD/MM/YYYY'))
                || ' ás '
                || TRIM (TO_CHAR (SYSDATE, 'HH:MM:SS')) AS EMISSAO,
                CASE
                   WHEN TRIM (TO_CHAR (CAB.DTVAL, 'DD/MM/YYYY')) IS NULL
                      THEN TRIM (TO_CHAR (CAB.DTNEG, 'DD/MM/YYYY'))
                   WHEN TRIM (TO_CHAR (CAB.DTVAL, 'DD/MM/YYYY')) <
                            TRIM (TO_CHAR (CAB.DTNEG, 'DD/MM/YYYY'))
                      THEN TRIM (TO_CHAR (CAB.DTNEG, 'DD/MM/YYYY'))
                   ELSE TRIM (TO_CHAR (CAB.DTVAL, 'DD/MM/YYYY'))
                END AS DTVAL,
                TRIM (VEN.EMAIL) AS EMAIL,
                TRIM (TO_CHAR (   '('
                               || SUBSTR (EMP.TELEFONE, 1, 2)
                               || ')'
                               || SUBSTR (EMP.TELEFONE, 3, 6)
                               || '-'
                               || SUBSTR (EMP.TELEFONE, 9, 4)
                               || ' / '
                               || '('
                               || SUBSTR (EMP.FAX, 1, 2)
                               || ')'
                               || SUBSTR (EMP.FAX, 3, 6)
                               || '-'
                               || SUBSTR (EMP.FAX, 9, 4)
                              )
                     ) AS TELFAX,
                DECODE (TPV.CODTIPVENDA,
                        0, ' ',
                        INITCAP (TRIM (TPV.DESCRTIPVENDA))
                       ) AS DESCRTIPVENDA,
                DECODE (PAR.CODPARC,
                        0, ' ',
                           TRIM (TO_CHAR (PAR.CODPARC))
                        || ' - '
                        || INITCAP (TRIM (PAR.NOMEPARC))
                       ) AS PARCEIRO,
                DECODE (PAR.CODPARC,
                        0, ' ',
                        INITCAP (TRIM (PAR.NOMEPARC))
                       ) AS NOMEPARC,
                DECODE (LENGTH (TRIM (PAR.CGC_CPF)),
                        11, ' CPF: ',
                        NULL, ' ',
                        ' CNPJ: '
                       ) AS TIPOPESSOA,
                DECODE (LENGTH (TRIM (CGC_CPF)),
                        14, SUBSTR (TRIM (CGC_CPF), 1, 2)
                         || '.'
                         || SUBSTR (TRIM (CGC_CPF), 3, 3)
                         || '.'
                         || SUBSTR (TRIM (CGC_CPF), 6, 3)
                         || '/'
                         || SUBSTR (TRIM (CGC_CPF), 9, 4)
                         || '-'
                         || SUBSTR (TRIM (CGC_CPF), 13, 2),
                        11, SUBSTR (TRIM (CGC_CPF), 1, 3)
                         || '.'
                         || SUBSTR (TRIM (CGC_CPF), 4, 3)
                         || '.'
                         || SUBSTR (TRIM (CGC_CPF), 7, 3)
                         || '-'
                         || SUBSTR (TRIM (CGC_CPF), 10, 2),
                        TRIM (CGC_CPF)
                       ) AS CGC_CPF,
                DECODE (TRIM (PAR.IDENTINSCESTAD),
                        NULL, ' ',
                        TRIM (PAR.IDENTINSCESTAD)
                       ) AS IDENTINSCESTAD,
                DECODE (END.CODEND,
                        0, ' ',
                           INITCAP (TRIM (END.TIPO))
                        || ' '
                        || INITCAP (TRIM (END.NOMEEND))
                        || ', '
                        || TRIM (TO_CHAR (PAR.NUMEND))
                       ) AS ENDERECO,
                DECODE (BAI.CODBAI,
                        0, ' ',
                        INITCAP (TRIM (BAI.NOMEBAI))
                       ) AS BAIRRO,
                DECODE (CID.CODCID,
                        0, ' ',
                        INITCAP (TRIM (CID.NOMECID)) || ' - ' || TRIM (UFS.UF)
                       ) AS CIDADE,
                CASE
                   WHEN ENDR.NOMEEND = '<SEM ENDERECO>'
                   AND END.NOMEEND <> '<SEM ENDERECO>'
                      THEN    INITCAP (TRIM (END.TIPO))
                           || ' '
                           || INITCAP (TRIM (END.NOMEEND))
                           || ', '
                           || TRIM (PAR.NUMEND)
                   WHEN ENDR.NOMEEND <> '<SEM ENDERECO>'
                   AND END.NOMEEND = '<SEM ENDERECO>'
                      THEN    INITCAP (TRIM (ENDR.TIPO))
                           || ' '
                           || INITCAP (TRIM (ENDR.NOMEEND))
                           || ', '
                           || TRIM (CPL.NUMRECEB)
                   WHEN ENDR.CODEND <> END.CODEND
                   AND CPL.NUMRECEB <> PAR.NUMEND
                      THEN    INITCAP (TRIM (ENDR.TIPO))
                           || ' '
                           || INITCAP (TRIM (ENDR.NOMEEND))
                           || ', '
                           || TRIM (CPL.NUMRECEB)
                   ELSE ''
                END AS ENDERECORECEB,
                CASE
                   WHEN TRIM (BAIR.CODBAI) = 0
                      THEN ''
                   WHEN INITCAP (TRIM (BAIR.NOMEBAI)) <>
                             INITCAP (TRIM (BAI.NOMEBAI))
                      THEN INITCAP (TRIM (BAIR.NOMEBAI))
                   ELSE ''
                END AS BAIRRORECEBIMETO,
                CASE
                   WHEN CIDR.CODCID = 0 AND CID.CODCID > 0
                      THEN    INITCAP (TRIM (CID.NOMECID))
                           || ' - '
                           || TRIM (UFS.UF)
                   WHEN CIDR.CODCID > 0 AND CID.CODCID = 0
                      THEN    INITCAP (TRIM (CIDR.NOMECID))
                           || ' - '
                           || TRIM (UFSR.UF)
                   WHEN CIDR.CODCID = 0 AND CID.CODCID > 0
                      THEN    INITCAP (TRIM (CID.NOMECID))
                           || ' - '
                           || TRIM (UFS.UF)
                   ELSE ''
                END AS CIDRECEBIMENTO,
                DECODE (VEN.CODVEND,
                        0, ' ',
                           TRIM (VEN.CODVEND)
                        || ' - '
                        || INITCAP (TRIM (VEN.APELIDO))
                       ) AS VENDEDOR,
                TRIM (TO_CHAR (CAB.DTNEG, 'DD/MM/YYYY')) AS NEGOCIACAO,
                INITCAP (TRIM (USU.NOMEUSU)) AS USERNAME,
                NVL(PAR.EMAILNFE, PAR.EMAIL) AS EMAILFOR,
                TRIM(PAR.TELEFONE) AS TELFORN
           FROM TGFCAB CAB
      LEFT JOIN TSIEMP EMP  ON CAB.CODEMP = EMP.CODEMP
      LEFT JOIN TSIEND ENDE ON ENDE.CODEND = EMP.CODEND
      LEFT JOIN TSIBAI BAIE ON BAIE.CODBAI = EMP.CODBAI
      LEFT JOIN TSICID CIDE ON CIDE.CODCID = EMP.CODCID
      LEFT JOIN TSIUFS UFSE ON UFSE.CODUF = CIDE.UF
      LEFT JOIN TGFVEN VEN  ON VEN.CODVEND = CAB.CODVEND
      LEFT JOIN TGFTPV TPV  ON TPV.CODTIPVENDA = CAB.CODTIPVENDA
      LEFT JOIN TGFPAR PAR  ON PAR.CODPARC = CAB.CODPARC
      LEFT JOIN TSIEND END  ON END.CODEND = PAR.CODEND
      LEFT JOIN TSIBAI BAI  ON BAI.CODBAI = PAR.CODBAI
      LEFT JOIN TSICID CID  ON CID.CODCID = PAR.CODCID
      LEFT JOIN TSIUFS UFS  ON UFS.CODUF = CID.UF
      LEFT JOIN TGFCPL CPL  ON CPL.CODPARC = PAR.CODPARC
      LEFT JOIN TSICID CIDR ON CIDR.CODCID = CPL.CODCIDRECEB
      LEFT JOIN TSIUFS UFSR ON UFSR.CODUF = CIDR.UF
      LEFT JOIN TSIBAI BAIR ON BAIR.CODBAI = CPL.CODBAIRECEB
      LEFT JOIN TSIEND ENDR ON ENDR.CODEND = CPL.CODENDRECEB
      LEFT JOIN TSIUSU USU  ON USU.CODUSU = Stp_Get_Codusulogado
           WHERE CAB.NUNOTA = $P{PK_NUNOTA}]]>
	</queryString>
