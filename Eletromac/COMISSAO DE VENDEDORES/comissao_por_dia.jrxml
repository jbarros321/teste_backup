	</variable>
	<variable name="Vlr Comis Vend_1" class="java.math.BigDecimal" resetType="Group" resetGroup="Cód.Vendedor" calculation="Sum">
		<variableExpression><![CDATA[$F{Vlr Comis Vend}]]></variableExpression>
	</variable>
	<variable name="CODVEND" class="java.lang.String" resetType="Group" resetGroup="Cód.Vendedor" incrementType="Group" incrementGroup="Cód.Vendedor">
		<variableExpression><![CDATA[$F{Cód.Vendedor}]]></variableExpression>
	</variable>
