					</textElement>
					<text><![CDATA[Valor Total]]></text>
				</staticText>
				<staticText>
					<reportElement x="483" y="13" width="69" height="13"/>
					<textElement verticalAlignment="Middle">
						<font size="8"/>
					</textElement>
					<text><![CDATA[Vlr. Comissão]]></text>
				</staticText>
				<textField>
					<reportElement x="0" y="0" width="552" height="13"/>
					<textElement textAlignment="Center" verticalAlignment="Middle" markup="none">
						<font isBold="true"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA["Comissão para Vendedor " +$F{Cód.Vendedor} +" - " +$F{Apelido do Vendedor}]]></textFieldExpression>
				</textField>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="57">
				<textField pattern="¤ #,##0.00">
					<reportElement x="100" y="0" width="81" height="13"/>
					<textElement verticalAlignment="Middle">
						<font size="8" isBold="true"/>
					</textElement>
					<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{Valor Vista_2}]]></textFieldExpression>
				</textField>
				<textField pattern="¤ #,##0.00">
					<reportElement x="181" y="0" width="75" height="13"/>
