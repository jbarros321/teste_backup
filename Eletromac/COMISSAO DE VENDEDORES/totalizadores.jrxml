					<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{Valor Prazo_2}]]></textFieldExpression>
				</textField>
				<textField pattern="¤ #,##0.00">
					<reportElement x="325" y="0" width="76" height="13"/>
