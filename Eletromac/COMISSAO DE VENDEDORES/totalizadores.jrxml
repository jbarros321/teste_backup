						<font size="8"/>
					</textElement>
					<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{META_90}]]></textFieldExpression>
				</textField>
				<textField pattern="¤ #,##0.00" isBlankWhenNull="true">
					<reportElement x="179" y="30" width="81" height="13"/>
					<textElement verticalAlignment="Middle">
						<font size="8"/>
					</textElement>
					<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{META_100}]]></textFieldExpression>
				</textField>
				<textField pattern="¤ #,##0.00" isBlankWhenNull="true">
					<reportElement x="308" y="30" width="82" height="13"/>
					<textElement verticalAlignment="Middle">
						<font size="8"/>
					</textElement>
					<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{META_110}]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement x="0" y="30" width="50" height="13"/>
					<textElement verticalAlignment="Middle">
						<font size="8"/>
					</textElement>
					<text><![CDATA[Meta 90 %]]></text>
				</staticText>
				<staticText>
					<reportElement x="130" y="30" width="50" height="13"/>
					<textElement verticalAlignment="Middle">
						<font size="8"/>
					</textElement>
					<text><![CDATA[Meta 100 %]]></text>
				</staticText>
				<staticText>
					<reportElement x="259" y="30" width="50" height="13"/>
					<textElement verticalAlignment="Middle">
						<font size="8"/>
					</textElement>
					<text><![CDATA[Meta 110 %]]></text>
				</staticText>
				<textField>
					<reportElement x="0" y="18" width="552" height="13"/>
					<textElement textAlignment="Center" verticalAlignment="Middle" markup="none">
						<font isBold="true"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA["Prêmio para Vendedor " +$F{Cód.Vendedor} +" - " +$F{Apelido do Vendedor}]]></textFieldExpression>
				</textField>
